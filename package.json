{
  "name": "homefix-uber-like-app",
  "version": "0.1.0",
  "private": true,
  "description": "HomeFix quality-first project foundation before application implementation.",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "node --import tsx server/src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "integrity:files": "node scripts/check-file-integrity.mjs",
    "security:audit": "npm audit --audit-level=high",
    "quality": "npm run integrity:files && npm run format:check && npm run lint && npm run typecheck && npm test && npm run security:audit",
    "test": "node --import tsx --test --test-concurrency=1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@eslint/js": "9.28.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.15.29",
    "@types/pg": "^8.20.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "prettier": "3.5.3",
    "tsx": "^4.20.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
