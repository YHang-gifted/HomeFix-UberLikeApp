# Keep the build context small and the image free of things the server doesn't run.
node_modules
**/node_modules
.git
.github
.expo
coverage
dist
build

# Note: `app-expo` and `app` are intentionally NOT ignored — the web-build stage
# exports the Expo web bundle from them (their node_modules are excluded above).
# Only the built `app-expo/dist` is copied into the runtime image.

# Tests, docs, and tooling are not needed at runtime.
tests
docs
scripts

# Never ship local env files; the image is configured via real env vars.
.env
.env.*
