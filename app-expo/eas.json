{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homefix-uberlikeapp-production.up.railway.app",
        "EXPO_PUBLIC_CONNECT_PAYOUTS_ENABLED": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homefix-uberlikeapp-production.up.railway.app",
        "EXPO_PUBLIC_CONNECT_PAYOUTS_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homefix-uberlikeapp-production.up.railway.app",
        "EXPO_PUBLIC_CONNECT_PAYOUTS_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
