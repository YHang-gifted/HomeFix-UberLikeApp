# The HomeFix backend the app talks to. Expo inlines EXPO_PUBLIC_* at build time.
# For a deployed build, set this to your API URL, e.g. the Railway domain:
# EXPO_PUBLIC_API_BASE_URL=https://homefix-uberlikeapp-production.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Static Maps API key. Set it to show a small map thumbnail on a request's
# Location (tap it to open the full interactive Google Maps). Leave it unset and the
# app shows the coordinates/address text + "Open in Maps" link only (no thumbnail).
# Enable the "Maps Static API" for the key in Google Cloud, and restrict it.
EXPO_PUBLIC_GOOGLE_MAPS_STATIC_KEY=

# Google Maps JavaScript API key. Set it to enable the web "Pick on map" flow (drag a
# pin to set the exact location) on the New Request form. Leave it unset and the button
# is hidden on web (native uses react-native-maps regardless). Enable the "Maps
# JavaScript API" for the key and restrict it the same way (HTTP referrers → web
# origin). You may reuse the static-map key if it allows both APIs.
EXPO_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Offer PayPal as a checkout method on the payment form. Set to `true` only when the
# server has PayPal configured (PAYPAL_CLIENT_ID/SECRET/RETURN_URL/CANCEL_URL). Leave
# unset and only the default card provider is offered (no method picker).
EXPO_PUBLIC_PAYPAL_ENABLED=

# Show the worker "Set up payouts" button (Stripe Connect onboarding). Set to `true` only
# when the server has Connect configured (STRIPE_SECRET_KEY + STRIPE_CONNECT_RETURN_URL /
# STRIPE_CONNECT_REFRESH_URL). Leave unset and the button is hidden.
EXPO_PUBLIC_CONNECT_PAYOUTS_ENABLED=
