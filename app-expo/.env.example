# The HomeFix backend the app talks to. Expo inlines EXPO_PUBLIC_* at build time.
# For a deployed build, set this to your API URL, e.g. the Railway domain:
# EXPO_PUBLIC_API_BASE_URL=https://homefix-uberlikeapp-production.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Static Maps API key. Set it to show a small map thumbnail on a request's
# Location (tap it to open the full interactive Google Maps). Leave it unset and the
# app shows the coordinates/address text + "Open in Maps" link only (no thumbnail).
# Enable the "Maps Static API" for the key in Google Cloud, and restrict it.
EXPO_PUBLIC_GOOGLE_MAPS_STATIC_KEY=
