# Copy to .env for local development. Never commit real secrets.
#
# Only the variables in the "Active" section are read by the server
# (see server/src/config/env.ts). The "Planned" entries are placeholders for
# integrations that are not wired up yet.

# --- Active (read by the app) ---

# development | test | production
NODE_ENV=development

# HTTP port the server listens on (1-65535)
PORT=3000

# Postgres connection string. Leave empty to use the in-memory store (dev/test);
# set a real URL in production. Migrations run automatically on boot.
DATABASE_URL=postgresql://user:password@localhost:5432/homefix

# JWT signing secret (min 16 chars). MUST be overridden in production with a
# strong, non-default value — the server refuses to boot otherwise (SEC-0004).
JWT_SECRET=replace_with_local_secret_at_least_16_chars

# Token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_IN=604800

# Comma-separated browser origins allowed to call the API. Empty serves a
# permissive `*` (development only); set the real web origin(s) in production
# (SEC-0002). Example: https://app.homefix.example,https://admin.homefix.example
CORS_ALLOWED_ORIGINS=

# --- Planned (not yet read by the app) ---
# STRIPE_SECRET_KEY=
# GOOGLE_MAPS_API_KEY=
# PUSH_NOTIFICATION_KEY=
# REDIS_URL=redis://localhost:6379
