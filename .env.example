# Copy to .env for local development. Never commit real secrets.
#
# Only the variables in the "Active" section are read by the server
# (see server/src/config/env.ts). The "Planned" entries are placeholders for
# integrations that are not wired up yet.

# --- Active (read by the app) ---

# development | test | production
NODE_ENV=development

# HTTP port the server listens on (1-65535)
PORT=3000

# Log output format: json | pretty. json (the default) writes one self-contained
# JSON object per line for a log drain to index; set pretty for a human-readable
# line in local dev.
LOG_FORMAT=

# Bearer token guarding the Prometheus GET /metrics endpoint. Set it and scrapers
# must send `Authorization: Bearer <token>`; leave it unset and /metrics is open
# (dev / trusted network). Set it, or restrict /metrics at the proxy, in production.
METRICS_TOKEN=

# SEC-0009. LOCAL DEVELOPMENT ONLY — the server REFUSES TO BOOT in production with this on.
# When no mail provider is configured, notifications fall back to an inert sender that only
# records that a message would have been sent. Set this to `true` and it logs the recipient
# and the full body as well.
#
# That body is the secret: the password-reset mail carries the PLAINTEXT reset token (only its
# hash is stored), so logging it hands account takeover to anyone who can read the logs — and
# logs get shipped to a drain. It exists purely so you can test forgot-password on a laptop,
# where there is otherwise no way to recover the token at all. Leave it empty.
NOTIFY_LOG_BODY=

# Postgres connection string. Leave empty to use the in-memory store (dev/test);
# set a real URL in production. Migrations run automatically on boot.
DATABASE_URL=postgresql://user:password@localhost:5432/homefix

# JWT signing secret (min 16 chars). MUST be overridden in production with a
# strong, non-default value — the server refuses to boot otherwise (SEC-0004).
JWT_SECRET=replace_with_local_secret_at_least_16_chars

# Token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_IN=604800

# Comma-separated browser origins allowed to call the API. Empty serves a
# permissive `*` (development only); set the real web origin(s) in production
# (SEC-0002). Example: https://app.homefix.example,https://admin.homefix.example
CORS_ALLOWED_ORIGINS=

# Comma-separated notification delivery channels to enable. Known values: email,
# push. Empty (the default) delivers to no external channel. The channels are
# recording mocks until a real provider is wired in. Example: email,push
NOTIFY_CHANNELS=

# Whether to seed the three demo users on boot (true|false). Unset seeds outside
# production but never in production, so a real deploy won't create demo
# accounts. Set to true only if you explicitly want demo accounts in production.
SEED_DEMO_USERS=

# Email delivery provider. EMAIL_API_URL receives a JSON {from,to,subject,text} POST
# with `Authorization: Bearer EMAIL_API_KEY` — which is exactly Resend's send API, so it
# needs no adapter. All three must be set; leave any of them unset and the email channel
# falls back to the inert sender and NOTHING IS SENT.
#
# These three alone switch on the PASSWORD-RESET mail — password reset does NOT consult
# NOTIFY_CHANNELS. Until they are set, `POST /auth/forgot-password` sends nothing and a
# user who forgets their password cannot get back in. (Adding "email" to NOTIFY_CHANNELS
# is a separate decision: it mails ordinary notifications too.) See docs/email-go-live.md.
#
# EMAIL_FROM takes a bare address or the display-name form: `HomeFix <noreply@example.com>`.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Push delivery endpoint (with NOTIFY_CHANNELS including "push"). Set it to send
# real push, e.g. the Expo push API; leave unset and the push channel only logs.
# Example: https://exp.host/--/api/v2/push/send
PUSH_API_URL=

# Object storage for uploaded images (S3 or S3-compatible). Set the bucket,
# region, and credentials to store images in real object storage — the API then
# returns a presigned PUT URL the client uploads to directly. Leave any unset and
# uploads use the in-memory mock store (dev/test). Never commit real credentials.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Public read base for stored images (a CDN or the bucket URL). If unset, the
# bucket's virtual-hosted S3 URL is used. Example: https://cdn.homefix.example
STORAGE_S3_PUBLIC_BASE_URL=
# Custom endpoint for S3-compatible storage (Cloudflare R2, MinIO, …).
STORAGE_S3_ENDPOINT=
# Presigned upload URL lifetime in seconds (default 900 = 15 min, max 3600).
STORAGE_S3_UPLOAD_EXPIRES_SECONDS=

# Stripe secret key. Set it to take real payments via Stripe hosted Checkout (the
# app opens a Checkout Session per payment and redirects the customer to Stripe);
# leave unset and the inert mock provider is used (dev/test). Use a test-mode key
# (sk_test_...) outside production. Never commit a real key.
STRIPE_SECRET_KEY=
# Where Stripe returns the customer after hosted Checkout. BOTH are required when
# STRIPE_SECRET_KEY is set (the server fails fast otherwise). Point them at the
# app's public URL with a marker so it can show the result, e.g.
# https://app.homefix.example/?payment=success and .../?payment=cancelled.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
# Stripe webhook signing secret (whsec_...). Set it (with STRIPE_SECRET_KEY) to
# accept Stripe's POST /webhooks/stripe callbacks — the Stripe-Signature header is
# verified against it and a checkout.session.completed event marks the payment paid.
# Unset and the Stripe webhook endpoint is disabled (404). Never commit a real value.
STRIPE_WEBHOOK_SECRET=

# Absolute path to the built web bundle (the Expo web export, app-expo/dist). Set
# it to serve the web app same-origin with the API (static assets + SPA fallback);
# leave unset and only the API is served (dev/test). Example: /app/app-expo/dist
WEB_DIST_DIR=

# --- Planned (not yet read by the app) ---
# GOOGLE_MAPS_API_KEY=
# PUSH_NOTIFICATION_KEY=
# REDIS_URL=redis://localhost:6379
