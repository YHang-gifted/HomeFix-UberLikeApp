# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/homefix
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace_with_local_secret
JWT_EXPIRES_IN=7d

# Third-party services
STRIPE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
PUSH_NOTIFICATION_KEY=
